# Copy this file to `.env` and adjust as needed. All values are optional.

# ---- Server ----
# Bind to localhost so the app is private and never exposed to the network.
HOST=127.0.0.1
PORT=8000

# ---- Vault ----
# Folder where your Markdown notes live (your "second brain").
VAULT_DIR=vault

# ---- Ollama (open-source local models) ----
# Install Ollama from https://ollama.com then run e.g. `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
# LiteLLM-style model id used by DSPy. Examples:
#   ollama_chat/llama3.1   ollama_chat/qwen2.5   ollama_chat/mistral
LLM_MODEL=ollama_chat/llama3.1

# ---- Embeddings (open-source, local, free) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the local vector index is stored.
CHROMA_DIR=.chroma
