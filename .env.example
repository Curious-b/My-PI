# Copy this file to `.env` and adjust as needed. All values are optional.

# ---- Server ----
# Bind to localhost so the app is private and never exposed to the network.
HOST=127.0.0.1
PORT=8000

# ---- Vault ----
# Folder where your Markdown notes live (your "second brain").
VAULT_DIR=vault

# ---- Schemas ----
# Folder where your uploaded JSON Schema template files (per document type)
# are stored for structured extraction during Upload.
SCHEMA_DIR=schemas

# ---- Ollama (open-source local models) ----
# Install Ollama from https://ollama.com then run e.g. `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
# LiteLLM-style model id used by DSPy. Examples:
#   ollama_chat/llama3.1   ollama_chat/qwen2.5   ollama_chat/mistral
LLM_MODEL=ollama_chat/llama3.1

# Ollama's own default context window is often only ~2048-4096 tokens —
# easily exceeded once a large JSON Schema plus document content is in the
# prompt, causing the model to silently lose track of most of it (garbled,
# sparse, or malformed output). If extraction against a rich/large schema
# comes back incomplete, raise this. Needs more RAM/VRAM the higher you go.
OLLAMA_NUM_CTX=8192
# How many tokens the model is allowed to generate. A schema with many
# sections/fields needs more room to be fully populated than a small one.
LLM_MAX_TOKENS=4096

# ---- Embeddings (open-source, local, free) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the local vector index is stored.
CHROMA_DIR=.chroma

# ---- Upload speed tuning (map-reduce for long documents) ----
# Fewer, larger chunks = fewer LLM round-trips = faster, but each call needs
# more of your model's context window. If uploads feel slow, try a smaller/
# faster model first (see README "Making extraction faster"); only raise
# CHUNK_SIZE if your model's context window can comfortably fit it.
CHUNK_SIZE=6000
MAX_CHUNKS=8
